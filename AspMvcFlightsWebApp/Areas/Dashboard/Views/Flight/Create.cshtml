@using AspMvcFlightsWebApp.Models;
@model AspMvcFlightsWebApp.Models.Flight

@{
    IEnumerable<Airport> airports = ViewData["Airports"] as IEnumerable<Airport>;
    IEnumerable<Airline> airlines = ViewData["Airlines"] as IEnumerable<Airline>;
}

<div class="row">
    <h4>Create New Flight</h4>
    <hr />

    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Date" class="control-label"></label>
                <input type="date" asp-for="Date" class="form-control" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Time" class="control-label"></label>
                <input type="time" asp-for="Time" class="form-control" />
                <span asp-validation-for="Time" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Airline" class="control-label"></label>
                <select asp-for="AirlineId" class="form-control">
                    @foreach (var airline in airlines)
                    {
                        <option value="@airline.Id">@airline.Title</option>
                    }
                </select>
                <span asp-validation-for="Airline" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Departure" class="control-label"></label>
                <select asp-for="DepartureId" class="form-control">
                    @foreach (var port in airports)
                    {
                        <option value="@port.Id">@port.Title</option>
                    }
                </select>
                <span asp-validation-for="Departure" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Arrival" class="control-label"></label>
                <select asp-for="ArrivalId" class="form-control">
                    @foreach (var port in airports)
                    {
                        <option value="@port.Id">@port.Title</option>
                    }
                </select>
                <span asp-validation-for="Arrival" class="text-danger"></span>
            </div>

            <div class="form-group mt-2">
                <button type="submit" class="btn btn-primary btn-sm">Create</button>
                <a asp-action="Index" class="btn btn-success btn-sm">Back To List</a>
            </div>
        </form>
    </div>
</div>
