@model AspMvcFlightsWebApp.Models.Airport

@{
    IEnumerable<City> cities = ViewData["Cities"] as IEnumerable<City>;
}

<h4>Create New Airport</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="City" class="control-label"></label>
                
                <select asp-for="CityId" class="form-control">
                    @foreach (var city in cities)
                    {
                        <option value="@city.Id">@city.Title</option>
                    }
                </select>

                <span asp-validation-for="City" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary btn-sm">Create</button>
                <a asp-action="Index" class="btn btn-success btn-sm">Back To List</a>
            </div>
        </form>
    </div>
</div>
