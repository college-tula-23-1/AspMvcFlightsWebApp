@model City

<h4>Are you sure you want to delete @Model.Title?</h4>

<div>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Airports)
        </dt>
        <dd class="col-sm-10">
            <ul class="list-group">
                @foreach (var port in Model.Airports)
                {
                    <li class="list-group-item">@port.Title</li>
                }
            </ul>
        </dd>
    </dl>
</div>
<div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" 
                class="btn btn-sm btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-sm btn-success">Back To List</a>
    </form>
</div>